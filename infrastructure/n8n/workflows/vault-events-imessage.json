{
  "name": "Vault Events → iMessage",
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "wh1",
      "name": "Vault Events Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "vault-events",
      "parameters": {
        "path": "vault-events",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "noData"
      }
    },
    {
      "id": "bb1",
      "name": "Send iMessage via BlueBubbles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:1234/api/v1/message/text?password=Vault2026bb",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatGuid\": \"any;-;diego.teran.a@gmail.com\",\n  \"tempGuid\": \"{{ $now.toMillis() }}\",\n  \"message\": \"🔔 Vault — {{ $json.event }}{{ $json.notes ? '\\n' + $json.notes : '' }}\"\n}"
      }
    }
  ],
  "connections": {
    "Vault Events Webhook": {
      "main": [[{ "node": "Send iMessage via BlueBubbles", "type": "main", "index": 0 }]]
    }
  }
}
