{
  "name": "Vault Events → iMessage",
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "wh1",
      "name": "Vault Events Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "vault-events",
      "parameters": {
        "path": "vault-events",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "noData"
      }
    },
    {
      "id": "bb1",
      "name": "Send iMessage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5580/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"message\": \"Vault: \" + $json.event + ($json.notes ? \" - \" + $json.notes : \"\") }"
      }
    }
  ],
  "connections": {
    "Vault Events Webhook": {
      "main": [[{ "node": "Send iMessage", "type": "main", "index": 0 }]]
    }
  }
}
