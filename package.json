{
  "name": "arca",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @arca/db generate",
    "db:migrate": "pnpm --filter @arca/db migrate",
    "db:studio": "pnpm --filter @arca/db studio"
  },
  "pnpm": {
    "ignoredBuiltDependencies": ["react-native-screens"],
    "neverBuiltDependencies": ["react-native-screens"],
    "overrides": {
      "@types/react": "18.3.28"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
